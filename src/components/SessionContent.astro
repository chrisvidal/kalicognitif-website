---
const items = [
  {
    titre: "Travail à mains nues, gants ou bâtons de mousse",
    description:
      "Des outils pédagogiques progressifs, fournis par le coach et adaptés au niveau de chaque participant.",
  },
  {
    titre: "Beaucoup plus qu'un travail cardio",
    description:
      "La boxe intuitive (voir vidéo ci-dessous) est une boxe axée sur la concentration, le ressenti, la fluidité des mouvements et le réflexe naturel. C'est sans danger, sans violence. C'est ludique. Sa pratique améliore le cardio, l'acuité mentale, le défoulement et l'agilité sans risque de blessure",
  },
  {
    titre: "Une initiation à l'auto-défense",
    description:
      "Le Kali transmet des réflexes de protection simples, applicables et rassurants au quotidien.",
  },
];
---

<section class="px-6 py-20 sm:px-10 lg:px-16">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-center text-3xl font-extrabold text-ink sm:text-4xl">
      Le contenu des sessions
    </h2>

    <ul class="mt-12 space-y-6">
      {
        items.map((item) => (
          <li class="flex gap-4 rounded-xl bg-gray-50 p-5 border border-gray-200">
            <span class="mt-2 h-2 w-2 flex-none rounded-full bg-crimson" />
            <div>
              <h3 class=" text-xl font-bold text-ink">{item.titre}</h3>
              <p class="mt-2 text-lg text-ink/70">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
